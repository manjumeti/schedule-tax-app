# Application environment (12-factor config)
APP_ENVIRONMENT=local
APP_DEBUG=true

# SQLite for local dev; swap for PostgreSQL in staging/production, e.g.:
# APP_DATABASE_URL=postgresql+asyncpg://tax_app:changeme@db:5432/tax_app
APP_DATABASE_URL=sqlite+aiosqlite:///./schedule_tax.db
APP_DATABASE_ECHO=false

# Secrets: NEVER commit real values. Inject via your secrets manager in prod.
APP_SECRET_KEY=change-me-in-production-please
APP_CSRF_SECRET=change-me-csrf-secret

APP_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

# "manual" (default, no outbound calls) or "yfinance_sbi" (SBI TT BUY rates
# from scripts/data/<year>/sbi_tt_buy_rates.csv + Yahoo Finance stock prices).
APP_MARKET_DATA_PROVIDER=manual
APP_SBI_RATES_CSV_DIR=../scripts/data
